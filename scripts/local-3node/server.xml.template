<?xml version="1.0" encoding="UTF-8"?>
<Server port="@SHUTDOWN_PORT@" address="127.0.0.1" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
  <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />
  <GlobalNamingResources />
  <Service name="Catalina">
    <Connector address="127.0.0.1" port="@APP_PORT@" protocol="org.apache.coyote.http11.Http11NioProtocol" SSLEnabled="true" maxThreads="100">
      <SSLHostConfig protocols="TLSv1.2,TLSv1.3">
        <Certificate certificateKeystoreFile="@APP_SERVER_KEYSTORE@" certificateKeystorePasswordFile="@APP_SERVER_PASSWORD_FILE@" certificateKeystoreType="PKCS12" />
      </SSLHostConfig>
    </Connector>
    <Connector address="127.0.0.1" port="@P2P_PORT@" protocol="org.apache.coyote.http11.Http11NioProtocol" SSLEnabled="true" maxThreads="100">
      <SSLHostConfig protocols="TLSv1.2,TLSv1.3" certificateVerification="required" truststoreFile="@P2P_CLIENT_TRUSTSTORE@" truststorePassword="@P2P_CLIENT_TRUSTSTORE_PASSWORD@" truststoreType="PKCS12">
        <Certificate certificateKeystoreFile="@P2P_SERVER_KEYSTORE@" certificateKeystorePasswordFile="@P2P_SERVER_PASSWORD_FILE@" certificateKeystoreType="PKCS12" />
      </SSLHostConfig>
    </Connector>
    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps" unpackWARs="true" autoDeploy="false" deployOnStartup="true">
        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs" prefix="localhost_access_log" suffix=".txt" pattern="%h %l %u %t &quot;%r&quot; %s %b" />
      </Host>
    </Engine>
  </Service>
</Server>